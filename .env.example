# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Real environment variables (CI, Docker, systemd, ...) override this file.

# --- Django ---------------------------------------------------------------
# book_shop.settings.development  (local)  |  book_shop.settings.production
DJANGO_SETTINGS_MODULE=book_shop.settings.production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=shop.example.com
# Production: must be https:// origins
CSRF_TRUSTED_ORIGINS=https://shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com

# --- Production security (defaults shown; all optional) -------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DB_CONN_MAX_AGE=60

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=books_db
POSTGRES_USER=books_db_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=books_db
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_HOST=redis
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# --- E-mail (production requires EMAIL_HOST_USER / EMAIL_HOST_PASSWORD) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Book Shop <noreply@example.com>

# --- Sentry (optional) ----------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================================================
# Warehouse service (ProjectB, folder `support/`)
# ===========================================================================
# Everything below is OPTIONAL: docker-compose.yml has safe local defaults for each.
# Real deployments must override the secrets.

# Turn the integration on in ProjectA (it keeps working standalone when False).
# After enabling for the first time run once (see README):
#   docker compose exec web python manage.py seed_warehouse --email OPERATOR --password PASS
WAREHOUSE_ENABLED=False

# The ProjectB account ProjectA logs in with (created automatically on start).
WAREHOUSE_SERVICE_EMAIL=projecta@warehouse.local
WAREHOUSE_SERVICE_PASSWORD=change-me-service-password

# Shared secret that signs webhooks ProjectB -> ProjectA (one value for both projects).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
WAREHOUSE_WEBHOOK_SECRET=change-me-shared-secret

# ProjectB's own Django/Postgres settings (separate database and credentials).
# support.settings.development (local) | support.settings.production
WAREHOUSE_DJANGO_SETTINGS_MODULE=support.settings.development
WAREHOUSE_SECRET_KEY=change-me-warehouse-secret-key
# Must contain the Docker DNS name ProjectA uses to call it.
WAREHOUSE_ALLOWED_HOSTS=localhost,127.0.0.1,warehouse-web
# Production: https:// origins only.
WAREHOUSE_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
WAREHOUSE_POSTGRES_DB=warehouse_db
WAREHOUSE_POSTGRES_USER=warehouse_user
WAREHOUSE_POSTGRES_PASSWORD=change-me-warehouse-db-password
